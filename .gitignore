# Dépendances et sorties de build
node_modules/
dist/

# Rust : cible de compilation et APK produits par xbuild ; cible du client Linux
android/target/
linux/target/

# Régénérés par les builds : `npm run vendor` (web) et `npm run build` (extension,
# qui recopie les modules partagés de web/js et embarque l'app). Une seule
# source, web/ : les copies ne se versionnent pas.
web/vendor/
extension/src/lib/
extension/src/fonts/
extension/src/icons/
extension/src/app/

# Régénérés par `npm run gen` (android) : textes convertis depuis web/js/locales
# et fixtures d'interopérabilité chiffrées par le vrai vault.js
android/crates/mymfa-core/src/texts/fr.rs
android/crates/mymfa-core/src/texts/en.rs
android/crates/mymfa-core/tests/fixtures/

# Captures laissées par les tests de bout en bout en cas d'échec
/web/*.png
/extension/*.png

# Outillage local de l'assistant
.dual-graph/
.claude/
CLAUDE.md
.zcode/
