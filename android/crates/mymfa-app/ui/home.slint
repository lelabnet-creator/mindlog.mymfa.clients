// Vue Codes : cartes de comptes, filtres (Tous / Favoris / tags), recherche,
// anneau de décompte remplacé par une barre fine + secondes, FAB d'ajout.
import { Theme, I18n, Chip, Tile, IconSearch, IconPlus, IconStar, IconCopy, IconLock, IconRefresh } from "common.slint";
import { AccountRow } from "structs.slint";

export component AccountCard inherits Rectangle {
    in property <AccountRow> account;
    callback tapped(string);
    callback favorite(string);
    callback next-code(string);
    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    height: 84px;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Tile {
                initials: account.initials;
                tile-color: account.tile-color;
                width: 44px; height: 44px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: account.issuer != "" ? account.issuer : account.account;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: account.issuer != "" && account.account != "" ? account.account : "";
                color: Theme.muted;
                font-size: 12.5px;
                overflow: elide;
                visible: self.text != "";
            }
            // Décompte : fine barre de progression + secondes restantes (TOTP).
            if !account.hotp && !account.masked : Rectangle {
                height: 10px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 92px; height: 4px; border-radius: 2px;
                        background: Theme.ring-track;
                        Rectangle {
                            x: parent.width * (1 - account.progress);
                            width: parent.width * account.progress;
                            height: parent.height;
                            border-radius: 2px;
                            background: account.progress < 0.25 ? Theme.warn : Theme.accent;
                        }
                    }
                    Text {
                        text: I18n.tn("list.remaining", account.remaining);
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: account.code;
            color: account.masked ? Theme.muted : Theme.text;
            font-size: 24px;
            font-weight: 800;
            vertical-alignment: center;
            letter-spacing: 1px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 0;
            if account.hotp : Rectangle {
                height: 34px; width: 34px;
                border-radius: 17px;
                background: Theme.surface-2;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        IconRefresh { width: 16px; height: 16px; color: Theme.text-2; }
                    }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.next-code(root.account.id); } }
            }
            Rectangle {
                width: 30px; height: 26px;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        IconStar { width: 22px; height: 22px; filled: account.favorite; }
                    }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.favorite(root.account.id); } }
            }
            Rectangle {
                width: 30px; height: 26px;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        IconCopy { width: 20px; height: 20px; color: Theme.muted; }
                    }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.tapped(root.account.id); } }
            }
        }
    }
    // Le toucher de la carte révèle (si masqué) puis copie, comme le web.
    TouchArea {
        clicked => { root.tapped(root.account.id); }
    }
}

export component HomeView inherits Rectangle {
    in property <[AccountRow]> accounts: [];   // déjà filtrées par le backend
    in property <[string]> tags: [];
    in property <bool> has-accounts: false;    // avant filtrage (état vide vs aucun résultat)
    callback open-new();
    callback card-tapped(string);
    callback favorite(string);
    callback next-code(string);
    callback lock-now();
    callback apply-filter(string, int, string);

    property <string> query: "";
    property <int> filter: 0;      // 0 Tous, 1 Favoris, 2..n tags
    property <string> active-tag: "";

    background: Theme.bg;

    VerticalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: Theme.safe-top;
        // En-tête : titre + verrouiller.
        Rectangle {
            height: 58px;
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                alignment: space-between;
                Text {
                    text: I18n.t("home.title");
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                lock-button := Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 20px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            IconLock { width: 18px; height: 18px; color: Theme.text-2; }
                        }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.lock-now(); } }
                }
            }
        }

        // Recherche.
        Rectangle {
            height: 46px;
            border-radius: Theme.radius-control;
            background: Theme.surface;
            border-width: 1px;
            border-color: search.has-focus ? Theme.accent-line : Theme.border;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    IconSearch { width: 18px; height: 18px; }
                }
                search := TextInput {
                    text <=> root.query;
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.query == "" && search.preedit-text == "" ? I18n.t("home.search") : "";
                    color: Theme.muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }

        // Puces de filtre.
        HorizontalLayout {
            padding-top: 12px;
            spacing: 8px;
            alignment: start;
            Chip {
                label: I18n.t("list.allTags");
                active: root.filter == 0;
                clicked => { root.filter = 0; }
            }
            Chip {
                label: I18n.t("list.favorites");
                active: root.filter == 1;
                clicked => { root.filter = 1; }
            }
            for tag[i] in root.tags : Chip {
                label: tag;
                active: root.filter == i + 2;
                clicked => { root.filter = i + 2; root.active-tag = tag; }
            }
        }

        // Liste / état vide.
        Rectangle {
            vertical-stretch: 1;
            if !root.has-accounts : VerticalLayout {
                alignment: center;
                padding: 40px;
                spacing: 10px;
                Text {
                    text: I18n.t("home.emptyTitle");
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: I18n.t("home.emptyText");
                    color: Theme.muted;
                    font-size: 13.5px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            Flickable {
                VerticalLayout {
                    padding: Theme.gutter;
                    padding-bottom: 120px;
                    spacing: 10px;
                    for account in root.accounts : AccountCard {
                        account: account;
                        tapped(id) => { root.card-tapped(id); }
                        favorite(id) => { root.favorite(id); }
                        next-code(id) => { root.next-code(id); }
                    }
                }
            }
        }
    }

    // FAB Ajouter, ancré au-dessus de la navigation.
    Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 96px;
        width: 56px; height: 56px;
        border-radius: 28px;
        background: Theme.primary-bg;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                IconPlus { width: 24px; height: 24px; color: Theme.primary-fg; }
            }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.open-new(); } }
    }
    changed query => { root.apply-filter(root.query, root.filter, root.active-tag); }
    changed filter => { root.apply-filter(root.query, root.filter, root.active-tag); }
    changed active-tag => { root.apply-filter(root.query, root.filter, root.active-tag); }
}
