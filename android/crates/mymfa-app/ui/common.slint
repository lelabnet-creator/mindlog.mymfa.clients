/* ───── Composants ───── */

// Bouton plein (primaire inversé, comme le web) ou discret.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> min-h: Theme.tap;
    callback clicked;
    border-radius: Theme.radius-control;
    background: !enabled ? Theme.surface-2
        : primary ? (danger ? Theme.danger : Theme.primary-bg)
        : danger ? Theme.danger-soft
        : Theme.surface-2;
    height: min-h;
    HorizontalLayout {
        alignment: center;
        padding-top: 12px;
        padding-bottom: 12px;
        Text {
            text: root.text;
            vertical-alignment: center;
            color: !enabled ? Theme.muted
                : primary ? (danger ? #FFFFFF : Theme.primary-fg)
                : danger ? Theme.danger : Theme.text-2;
            font-weight: 700;
            font-size: 15px;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Puce de filtre (Tous / Favoris / tags).
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;
    border-radius: 12px;
    height: 36px;
    background: active ? Theme.accent-soft : Theme.chip-bg;
    border-width: 1px;
    border-color: active ? Theme.accent-line : Theme.border;
    HorizontalLayout {
        padding-left: 14px;
                    padding-right: 14px;
        alignment: center;
        Text {
            text: label;
            vertical-alignment: center;
            color: active ? Theme.accent-text : Theme.text-2;
            font-size: 13px;
            font-weight: active ? 700 : 500;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Tuile à initiales, couleur stable par service (comme brandColor du web).
export component Tile inherits Rectangle {
    in property <string> initials;
    in property <color> tile-color: Theme.muted;
    width: self.height;
    border-radius: Theme.radius-control;
    background: Theme.tile-bg;
    border-width: 1px;
    border-color: Theme.tile-border;
    Text {
        text: initials;
        color: tile-color;
        font-weight: 800;
        font-size: 15px;
    }
}

// Champ de saisie étiqueté (bâti sur TextInput pour reprendre le dessin du web).
export component AppField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <string> error: "";
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    height: 76px;
    border-radius: Theme.radius-control;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : (error != "" ? Theme.danger : Theme.border);
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text {
            text: label;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
        }
        input := TextInput {
            color: Theme.text;
            font-size: 15px;
            input-type: root.input-type;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
        // Placeholder dessiné par-dessus, à la manière du LineEdit standard.
        Text {
            text: root.text == "" && input.preedit-text == "" ? root.placeholder : "";
            color: Theme.muted;
            font-size: 15px;
        }
    }
}

// Interrupteur avec libellés (Réglages).
export component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 64px;
    border-radius: Theme.radius-control;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: subtitle;
                color: Theme.muted;
                font-size: 12.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 0; }
        sw := Rectangle {
            width: 46px; height: 28px;
            border-radius: 14px;
            background: root.checked ? Theme.accent : Theme.surface-2;
            border-width: 1px;
            border-color: root.checked ? Theme.accent-line : Theme.border-2;
            Rectangle {
                x: root.checked ? parent.width - self.width - 3px : 3px;
                y: (parent.height - self.height) / 2;
                width: 22px; height: 22px;
                border-radius: 11px;
                background: root.checked ? #FFFFFF : Theme.muted;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

// Carte de section (Réglages).
export component SectionCard inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        if title != "": Text {
            text: title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }
        @children
    }
}
