// Socle commun : thème (palette transposée de web/css/style.css), i18n (textes
// web/js/locales via le cœur Rust), icônes (tracés SVG du web) et composants.
import { AccountRow } from "structs.slint";

/* ───── Palette ───── */

export global Theme {
    // Renseigné par le backend (réglage auto/clair/sombre ; auto → sombre en v1).
    in-out property <bool> light: false;

    out property <color> bg:          light ? #F2F5F9 : #070B13;
    out property <color> side:        light ? #FFFFFF : #0A0F18;
    out property <color> surface:     light ? #FFFFFF : #0E1420;
    out property <color> surface-2:   light ? #EEF2F7 : #141B29;
    out property <color> border:      light ? #E1E6EE : #1A2231;
    out property <color> border-2:    light ? #D2D9E3 : #283244;
    out property <color> text:        light ? #0B1220 : #EEF2F8;
    out property <color> text-2:      light ? #2E3A4C : #C3CBD8;
    out property <color> muted:       light ? #566275 : #8E9AAE;
    out property <color> accent:      light ? #0E9488 : #5EE6CF;
    out property <color> accent-text: light ? #0B7A72 : #5EE6CF;
    out property <color> accent-soft: light ? #E1F5F2 : #0F2A2A;
    out property <color> accent-line: light ? #9ED9D1 : #1F5C58;
    out property <color> warn:        light ? #9A5800 : #F2B65A;
    out property <color> danger:      light ? #B42318 : #FF8A8A;
    out property <color> danger-soft: light ? #FDECEC : #2E1A1E;
    out property <color> primary-bg:  light ? #0B1220 : #F4F7FB;
    out property <color> primary-fg:  light ? #FFFFFF : #0A0F1A;
    out property <color> ring-track:  light ? #E1E6EE : #1F2A3A;
    out property <color> chip-bg:     light ? #FFFFFF : #111826;
    out property <color> tile-bg:     light ? #FFFFFF : #F4F7FB;
    out property <color> tile-border: light ? #E1E6EE : transparent;

    out property <length> radius-card: 20px;
    out property <length> radius-control: 14px;
    out property <length> gutter: 16px;
    out property <length> tap: 44px;
    // Barre d'état système : v1 sans pont d'inserts natifs (AND-01), hauteur
    // fixe raisonnable ; les en-têtes de vues démarrent dessous.
    out property <length> safe-top: 30px;
}

/* ───── i18n ───── */

// Les textes viennent du cœur (web/js/locales via mymfa-core::texts). La lecture
// de `locale` dans t()/tn() rend les liaisons réactives au changement de langue.
export global I18n {
    in-out property <string> locale: "fr";
    pure callback t-impl(string, string) -> string;
    pure callback tn-impl(string, int, string) -> string;
    pure callback t1-impl(string, string, string) -> string;

    pure public function t(key: string) -> string {
        if (locale == "@@") { return key; }
        return t-impl(key, locale);
    }
    pure public function tn(key: string, n: int) -> string {
        if (locale == "@@") { return key; }
        return tn-impl(key, n, locale);
    }
    // Texte à un paramètre : `t1("settings.foot", "0.1.0")` remplace {version}.
    pure public function t1(key: string, param: string) -> string {
        if (locale == "@@") { return key; }
        return t1-impl(key, param, locale);
    }
}

