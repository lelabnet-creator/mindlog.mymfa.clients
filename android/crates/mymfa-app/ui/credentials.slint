// Vue Mots de passe : logins et passkeys des sites, dans le coffre — miroir de
// web/js/credentials.js. Mobile : liste, puis détail (retour arrière) ; éditeur
// en plein écran avec générateur et jauge de solidité.
import { Theme, I18n, Chip, Tile, AppButton, AppField, IconSearch, IconPlus, IconCopy, IconEye, IconEyeOff,
         IconEdit, IconTrash, IconBack, IconKey, IconShield, IconClose, IconChevron, IconRefresh } from "common.slint";
import { Slider } from "std-widgets.slint";
import { CredentialRow, CredentialDetail, CredCodeRow, CredPasskeyRow, CredLoginInput } from "structs.slint";

/* ─ Onglet (Tout / Mots de passe / Passkeys, avec compte) ─ */
component CredTab inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active: false;
    callback clicked;
    border-radius: 12px;
    height: 36px;
    background: active ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: active ? Theme.accent-line : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        Text {
            text: label;
            vertical-alignment: center;
            color: active ? Theme.accent-text : Theme.text-2;
            font-size: 13px;
            font-weight: active ? 700 : 500;
        }
        Text {
            text: "\{count}";
            vertical-alignment: center;
            color: active ? Theme.accent-text : Theme.muted;
            font-size: 12px;
            font-weight: 700;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/* ─ Ligne de liste : titre de section (kind -1) ou carte de site ─ */
component CredItem inherits Rectangle {
    in property <CredentialRow> entry;
    callback select(string);
    height: entry.kind < 0 ? 34px : 64px;
    if entry.kind < 0 : Text {
        text: entry.name;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.6px;
        vertical-alignment: center;
        height: parent.height;
    }
    if entry.kind >= 0 : Rectangle {
        border-radius: Theme.radius-control;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        height: 64px;
        HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Tile {
                initials: entry.initials;
                tile-color: entry.tile-color;
                width: 38px; height: 38px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: entry.name;
                color: Theme.text;
                font-size: 14.5px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: entry.sub;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if entry.chip-2fa : Rectangle {
            width: self.pw + 14px;
            height: 22px;
            border-radius: 11px;
            background: Theme.accent-soft;
            property <length> pw: two-fa-text.preferred-width;
            HorizontalLayout {
                alignment: center;
                two-fa-text := Text {
                    text: "2FA";
                    color: Theme.accent-text;
                    font-size: 10.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        if entry.chip-passkey : Rectangle {
            width: self.pw + 14px;
            height: 22px;
            border-radius: 11px;
            background: Theme.surface-2;
            property <length> pw: pk-text.preferred-width;
            HorizontalLayout {
                alignment: center;
                pk-text := Text {
                    text: "Passkey";
                    color: Theme.text-2;
                    font-size: 10.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconChevron { width: 16px; height: 16px; color: Theme.muted; }
        }
        }
        // Le toucher de la carte ouvre le détail.
        TouchArea { mouse-cursor: pointer; clicked => { root.select(root.entry.id); } }
    }
}

/* ─ Rangée de bloc du détail (copie d'un champ ou d'un code) ─ */
component DetailField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> secret: false;   // mot de passe : valeur masquée tant que non révélé
    in property <bool> revealed: false;
    callback copy;
    callback toggle-reveal;
    height: 62px;
    border-radius: Theme.radius-control;
    background: Theme.surface-2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: label;
                color: Theme.muted;
                font-size: 11.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: value;
                color: Theme.text;
                font-size: 15px;
                font-weight: secret && !revealed ? 600 : 500;
                overflow: elide;
            }
        }
        if secret : Rectangle {
            width: 38px; height: 38px;
            HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                if !revealed : IconEye { width: 19px; height: 19px; color: Theme.text-2; }
                if revealed : IconEyeOff { width: 19px; height: 19px; color: Theme.text-2; }
            } }
            TouchArea { mouse-cursor: pointer; clicked => { root.toggle-reveal(); } }
        }
        Rectangle {
            width: 38px; height: 38px;
            HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                IconCopy { width: 18px; height: 18px; color: Theme.muted; }
            } }
            TouchArea { mouse-cursor: pointer; clicked => { root.copy(); } }
        }
    }
}

/* ─ Rangée passkey du détail (suppression armée en deux temps) ─ */
component PasskeyRowItem inherits Rectangle {
    in property <CredPasskeyRow> passkey;
    callback remove(string);
    in property <bool> armed;
    callback arm(string);
    height: 62px;
    border-radius: Theme.radius-control;
    background: armed ? Theme.danger-soft : Theme.surface-2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            IconKey { width: 20px; height: 20px; color: armed ? Theme.danger : Theme.text-2; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: passkey.label;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: passkey.created;
                color: Theme.muted;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        Rectangle {
            width: 38px; height: 38px;
            HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                IconTrash { width: 18px; height: 18px; color: armed ? Theme.danger : Theme.muted; }
            } }
            TouchArea { mouse-cursor: pointer; clicked => {
                if (root.armed) { root.remove(root.passkey.id); }
                else { root.arm(root.passkey.id); }
            } }
        }
    }
}

/* ─ Rangée code 2FA du détail (code en direct, comme l'onglet Codes) ─ */
component CodeRowItem inherits Rectangle {
    in property <CredCodeRow> data;
    callback copy-code(string);
    height: 58px;
    border-radius: Theme.radius-control;
    background: Theme.surface-2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: data.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
                overflow: elide;
            }
            Rectangle {
                height: 10px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 80px; height: 4px; border-radius: 2px;
                        background: Theme.ring-track;
                        Rectangle {
                            x: parent.width * (1 - data.progress);
                            width: parent.width * data.progress;
                            height: parent.height;
                            border-radius: 2px;
                            background: data.progress < 0.25 ? Theme.warn : Theme.accent;
                        }
                    }
                    Text {
                        text: I18n.tn("list.remaining", data.remaining);
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: data.code;
            color: Theme.text;
            font-size: 20px;
            font-weight: 800;
            vertical-alignment: center;
            letter-spacing: 1px;
        }
        Rectangle {
            width: 38px; height: 38px;
            HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                IconCopy { width: 18px; height: 18px; color: Theme.muted; }
            } }
            TouchArea { mouse-cursor: pointer; clicked => { root.copy-code(root.data.id); } }
        }
    }
}

export component CredentialsView inherits Rectangle {
    in property <[CredentialRow]> entries: [];
    in property <int> count-all: 0;
    in property <int> count-logins: 0;
    in property <int> count-passkeys: 0;
    in property <bool> has-entries: false;
    in property <CredentialDetail> detail;
    in property <[CredCodeRow]> codes: [];
    in property <[CredPasskeyRow]> passkeys: [];
    in property <bool> detail-open: false;
    callback apply-filter(string, int);
    callback select(string);
    callback back();
    callback toggle-reveal(string);
    callback copy-user(string);
    callback copy-password(string);
    callback copy-code(string);
    callback save(CredLoginInput) -> string;
    callback remove-login(string);
    callback remove-passkey(string);
    callback prefill(string) -> CredLoginInput;   // préremplit l'éditeur (édition)
    callback generate(int, bool, bool, bool) -> string;
    callback password-strength(string) -> int;

    property <string> query: "";
    property <int> filter: 0;              // 0 Tout, 1 Mots de passe, 2 Passkeys
    property <bool> editor-open: false;
    in-out property <string> editor-id: "";        // « » = création
    in-out property <string> editor-url: "";
    in-out property <string> editor-username: "";
    in-out property <string> editor-password: "";
    in-out property <string> editor-title: "";
    property <bool> editor-reveal: false;
    property <string> editor-error: "";
    property <bool> confirm-remove: false;
    property <string> armed-passkey: "";
    property <int> gen-length: 20;
    property <bool> gen-digits: true;
    property <bool> gen-symbols: true;
    property <bool> gen-words: false;
    property <int> pw-level: 0;            // jauge de l'éditeur (mise à jour impérative)

    background: Theme.bg;

    /* ─ Liste ─ */
    VerticalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: Theme.safe-top;
        // En-tête : titre + générateur.
        Rectangle {
            height: 58px;
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: I18n.t("credentials.title");
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: I18n.t("credentials.subtitle");
                        color: Theme.muted;
                        font-size: 11.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 20px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                        IconRefresh { width: 18px; height: 18px; color: Theme.text-2; }
                    } }
                    TouchArea { mouse-cursor: pointer; clicked => {
                        root.gen-words = false; root.gen-length = 20;
                        root.editor-id = "";
                        root.editor-url = ""; root.editor-username = ""; root.editor-title = "";
                        root.editor-password = root.generate(20, true, true, false);
                        root.editor-reveal = true; root.editor-error = "";
                        root.confirm-remove = false; root.editor-open = true;
                    } }
                }
            }
        }

        // Recherche.
        Rectangle {
            height: 46px;
            border-radius: Theme.radius-control;
            background: Theme.surface;
            border-width: 1px;
            border-color: cred-search.has-focus ? Theme.accent-line : Theme.border;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                VerticalLayout { alignment: center; IconSearch { width: 18px; height: 18px; } }
                cred-search := TextInput {
                    text <=> root.query;
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.query == "" && cred-search.preedit-text == "" ? I18n.t("credentials.search") : "";
                    color: Theme.muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }

        // Onglets.
        HorizontalLayout {
            padding-top: 12px;
            spacing: 8px;
            alignment: start;
            CredTab {
                label: I18n.t("credentials.tabAll");
                count: root.count-all;
                active: root.filter == 0;
                clicked => { root.filter = 0; }
            }
            CredTab {
                label: I18n.t("credentials.tabLogins");
                count: root.count-logins;
                active: root.filter == 1;
                clicked => { root.filter = 1; }
            }
            CredTab {
                label: I18n.t("credentials.tabPasskeys");
                count: root.count-passkeys;
                active: root.filter == 2;
                clicked => { root.filter = 2; }
            }
        }

        // Liste / état vide (aucun élément, ou recherche sans résultat).
        Rectangle {
            vertical-stretch: 1;
            if !root.has-entries : VerticalLayout {
                alignment: center;
                padding: 40px;
                spacing: 10px;
                Text {
                    text: I18n.t("credentials.empty");
                    color: Theme.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            if root.has-entries && root.entries.length == 0 : VerticalLayout {
                alignment: center;
                padding: 40px;
                Text {
                    text: I18n.t("list.noMatch");
                    color: Theme.muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
            Flickable {
                VerticalLayout {
                    padding: Theme.gutter;
                    padding-bottom: 120px;
                    spacing: 8px;
                    for entry in root.entries : CredItem {
                        entry: entry;
                        select(id) => { root.select(id); }
                    }
                }
            }
        }
    }

    // Détail (écran, comme le web mobile) par-dessus la liste.
    if root.detail-open : Rectangle {
        background: Theme.bg;
        VerticalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            padding-top: Theme.safe-top;
            // En-tête : retour, tuile, nom + hôte, modifier.
            Rectangle {
                height: 64px;
                HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    spacing: 12px;
                    Rectangle {
                        width: 40px; height: 40px;
                        border-radius: 20px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                            IconBack { width: 20px; height: 20px; }
                        } }
                        TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.detail.name;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 800;
                            overflow: elide;
                        }
                        Text {
                            text: root.detail.host;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    if root.detail.is-login : Rectangle {
                        width: 40px; height: 40px;
                        border-radius: 20px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                            IconEdit { width: 17px; height: 17px; color: Theme.text-2; }
                        } }
                        TouchArea { mouse-cursor: pointer; clicked => {
                            let input = root.prefill(root.detail.id);
                            root.editor-id = input.id;
                            root.editor-url = input.url;
                            root.editor-username = input.username;
                            root.editor-password = input.password;
                            root.editor-title = input.title;
                            root.editor-reveal = false; root.editor-error = "";
                            root.confirm-remove = false;
                            root.editor-open = true;
                        } }
                    }
                }
            }

            Flickable {
                VerticalLayout {
                    padding: Theme.gutter;
                    padding-bottom: 40px;
                    spacing: 10px;

                    // Mot de passe : identifiant + secret (révélé ou masqué).
                    if root.detail.is-login : VerticalLayout {
                        spacing: 8px;
                        DetailField {
                            label: I18n.t("credentials.username");
                            value: root.detail.username;
                            copy => { root.copy-user(root.detail.id); }
                        }
                        DetailField {
                            label: I18n.t("credentials.password");
                            value: root.detail.password;
                            secret: true;
                            revealed: root.detail.revealed;
                            copy => { root.copy-password(root.detail.id); }
                            toggle-reveal => { root.toggle-reveal(root.detail.id); }
                        }
                    }

                    // Code 2FA du site, en direct.
                    if root.codes.length > 0 : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: I18n.t("credentials.code");
                            color: Theme.muted;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                        }
                        for row in root.codes : CodeRowItem {
                            data: row;
                            copy-code(id) => { root.copy-code(id); }
                        }
                    }

                    // Passkeys du site.
                    if root.passkeys.length > 0 : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.passkeys.length > 1 ? I18n.t("credentials.passkeysTitle") : I18n.t("credentials.passkeyTitle");
                            color: Theme.muted;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                        }
                        for passkey in root.passkeys : PasskeyRowItem {
                            passkey: passkey;
                            armed: root.armed-passkey == passkey.id;
                            remove(id) => { root.armed-passkey = ""; root.remove-passkey(id); }
                            arm(id) => { root.armed-passkey = id; }
                        }
                    }

                    Text {
                        text: root.detail.meta;
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // FAB Ajouter (comme l'onglet Codes).
    Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 96px;
        width: 56px; height: 56px;
        border-radius: 28px;
        background: Theme.primary-bg;
        HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
            IconPlus { width: 24px; height: 24px; color: Theme.primary-fg; }
        } }
        TouchArea { mouse-cursor: pointer; clicked => {
            root.editor-id = "";
            root.editor-url = ""; root.editor-username = ""; root.editor-title = "";
            root.editor-password = root.generate(20, true, true, false);
            root.editor-reveal = true; root.editor-error = "";
            root.confirm-remove = false; root.editor-open = true;
        } }
    }

    /* ─ Éditeur plein écran (création ou modification) ─ */
    if root.editor-open : Rectangle {
        background: Theme.bg;
        VerticalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            padding-top: Theme.safe-top;
            // En-tête : fermer, titre, enregistrer.
            Rectangle {
                height: 62px;
                HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    spacing: 10px;
                    Rectangle {
                        width: 40px; height: 40px;
                        border-radius: 20px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                            IconClose { width: 18px; height: 18px; color: Theme.text-2; }
                        } }
                        TouchArea { mouse-cursor: pointer; clicked => { root.editor-open = false; } }
                    }
                    Text {
                        text: root.editor-id == "" ? I18n.t("credentials.addTitle") : I18n.t("credentials.editTitle");
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 800;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    AppButton {
                        text: I18n.t(root.editor-id == "" ? "credentials.add" : "credentials.save");
                        primary: true;
                        min-h: 40px;
                        clicked => {
                            let err = root.save({
                                id: root.editor-id,
                                url: root.editor-url,
                                username: root.editor-username,
                                password: root.editor-password,
                                title: root.editor-title,
                            });
                            if (err == "") {
                                root.editor-open = false;
                                root.editor-error = "";
                            } else {
                                root.editor-error = err;
                            }
                        }
                    }
                }
            }

            Flickable {
                VerticalLayout {
                    padding: Theme.gutter;
                    padding-bottom: 40px;
                    spacing: 10px;

                    AppField {
                        label: I18n.t("credentials.url");
                        placeholder: "https://exemple.fr";
                        text <=> root.editor-url;
                        edited => { root.editor-error = ""; }
                    }
                    AppField {
                        label: I18n.t("credentials.username");
                        text <=> root.editor-username;
                        edited => { root.editor-error = ""; }
                    }
                    // Mot de passe : révélé selon l'interrupteur, régénéré par le générateur.
                    Rectangle {
                        height: 76px;
                        border-radius: Theme.radius-control;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: pw-input.has-focus ? Theme.accent-line : Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: I18n.t("credentials.password");
                                color: Theme.muted;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            pw-input := TextInput {
                                text <=> root.editor-password;
                                color: Theme.text;
                                font-size: 15px;
                                // Jamais de mot de passe en clair tapé sans le voir : le champ suit l'interrupteur.
                                input-type: root.editor-reveal ? InputType.text : InputType.password;
                                edited => { root.editor-error = ""; }
                                accepted => { }
                            }
                        }
                        HorizontalLayout {
                            x: parent.width - self.width - 8px;
                            y: 8px;
                            spacing: 2px;
                            Rectangle {
                                width: 34px; height: 34px;
                                HorizontalLayout { alignment: center; VerticalLayout { alignment: center;
                                    if !root.editor-reveal : IconEye { width: 17px; height: 17px; }
                                    if root.editor-reveal : IconEyeOff { width: 17px; height: 17px; }
                                } }
                                TouchArea { mouse-cursor: pointer; clicked => { root.editor-reveal = !root.editor-reveal; } }
                            }
                        }
                    }

                    // Jauge de solidité (4 segments, comme le verrouillage).
                    Rectangle {
                        height: 26px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for i in 4 : Rectangle {
                                width: 34px; height: 5px;
                                border-radius: 3px;
                                background: i < root.pw-level
                                    ? (root.pw-level <= 1 ? Theme.danger
                                        : root.pw-level == 2 ? Theme.warn : Theme.accent)
                                    : Theme.ring-track;
                            }
                            Text {
                                text: root.editor-password != "" && root.pw-level > 0
                                    ? I18n.t("security.strength." + root.pw-level) : "";
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Générateur : longueur, familles, phrase de syllabes, régénérer.
                    Rectangle {
                        border-radius: Theme.radius-card;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Text {
                                text: I18n.t("credentials.generator");
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            // Longueur : 12–40 caractères ou 3–8 mots (comme le web).
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.gen-words ? I18n.t("credentials.words") : I18n.t("credentials.length");
                                    color: Theme.muted;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    width: 90px;
                                }
                                Slider {
                                    height: 26px;
                                    minimum: root.gen-words ? 3 : 12;
                                    maximum: root.gen-words ? 8 : 40;
                                    // value est un float : liaison simple + retour en int.
                                    value: root.gen-length;
                                    changed value => { root.gen-length = Math.round(self.value); }
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "\{root.gen-length}";
                                    color: Theme.text-2;
                                    font-size: 13px;
                                    font-weight: 700;
                                    width: 26px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Chip {
                                    label: I18n.t("credentials.digits");
                                    active: root.gen-digits;
                                    clicked => { root.gen-digits = !root.gen-digits; }
                                }
                                Chip {
                                    label: I18n.t("credentials.symbols");
                                    active: root.gen-symbols;
                                    clicked => { root.gen-symbols = !root.gen-symbols; }
                                }
                                Chip {
                                    label: I18n.t("credentials.passphrase");
                                    active: root.gen-words;
                                    clicked => {
                                        root.gen-words = !root.gen-words;
                                        root.gen-length = root.gen-words ? 5 : 20;
                                    }
                                }
                            }
                            AppButton {
                                text: I18n.t("credentials.regenerate");
                                min-h: 40px;
                                clicked => {
                                    root.editor-password = root.generate(root.gen-length, root.gen-digits, root.gen-symbols, root.gen-words);
                                    root.editor-reveal = true;
                                }
                            }
                        }
                    }

                    // Lien avec le compte 2FA du site (info, comme le web).
                    Text {
                        text: root.editor-error != "" ? I18n.t("error." + root.editor-error) : "";
                        color: Theme.danger;
                        font-size: 13px;
                        wrap: word-wrap;
                        visible: root.editor-error != "";
                    }

                    // Suppression : armée en deux pressions (jamais de window.confirm ici).
                    if root.editor-id != "" : AppButton {
                        text: root.confirm-remove ? I18n.t("credentials.removeConfirm") : I18n.t("credentials.remove");
                        danger: true;
                        primary: root.confirm-remove;
                        clicked => {
                            if (root.confirm-remove) {
                                root.remove-login(root.editor-id);
                                root.editor-open = false;
                                root.confirm-remove = false;
                            } else {
                                root.confirm-remove = true;
                            }
                        }
                    }
                    Rectangle { height: 20px; }
                }
            }
        }
    }

    changed query => { root.apply-filter(root.query, root.filter); }
    changed filter => { root.apply-filter(root.query, root.filter); }
    changed editor-password => { root.pw-level = root.password-strength(root.editor-password); }
}
